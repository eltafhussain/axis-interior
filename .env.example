# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where quote requests are delivered
CONTACT_TO_EMAIL=info@axisinteriors.co.nz

# Sender address on a domain verified in Resend
CONTACT_FROM_EMAIL="Axis Interiors Website <website@axisinteriors.co.nz>"
